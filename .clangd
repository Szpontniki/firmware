# Those flags generated by `pio run --target compiledb` seem to be invalid.
CompileFlags:
  Remove:
    - -mlongcalls
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion

---
If:
  PathMatch: src/hardware/.*
CompileFlags:
  CompilationDatabase: src/hardware

---
If:
  PathMatch: src/entrypoints/hardware\.cpp
CompileFlags:
  CompilationDatabase: src/hardware

---
If:
  PathMatch: src/mock/.*
CompileFlags:
  CompilationDatabase: src/mock

---
If:
  PathMatch: src/entrypoints/mock\.cpp
CompileFlags:
  CompilationDatabase: src/mock

---
If:
  PathMatch: src/core/.*
CompileFlags:
  CompilationDatabase: src/mock
